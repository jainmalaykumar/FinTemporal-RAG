# ==========================================
# Financial Modeling Prep (FMP) API Configuration
# ==========================================
FMP_API_KEY=your_fmp_api_key

# ==========================================
# Local LLM & Ollama Settings
# ==========================================
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# If this machine sits behind a system-wide HTTP(S) proxy that intercepts
# even localhost traffic, uncomment these — otherwise every Ollama call gets
# routed through the proxy and times out (504 Gateway Timeout).
# NO_PROXY=localhost,127.0.0.1
# no_proxy=localhost,127.0.0.1

# ==========================================
# Vector Database Configuration
# ==========================================
CHROMA_DB_DIR=./data/chroma_db

# ==========================================
# Google OAuth (create credentials at console.cloud.google.com)
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
